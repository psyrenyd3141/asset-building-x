# LINE Developers コンソールで発行する、Messaging APIチャネルのチャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN=

# メッセージ送信先のLINEユーザーID (またはグループID/ルームID)
LINE_USER_ID=

# 省略可。設定すると、Claude APIでタスクを秘書らしい文章に整えて送信します。
# 未設定の場合は定型フォーマットのメッセージを送信します。
ANTHROPIC_API_KEY=

# 省略可。ANTHROPIC_API_KEY使用時のモデル指定。デフォルトは claude-sonnet-5。
ANTHROPIC_MODEL=

# ローカルで動作確認する際に、LINEへの実送信をスキップしてコンソール出力だけ確認したい場合に設定。
DRY_RUN=
