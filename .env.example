# LINE Developers コンソールで発行する、Messaging APIチャネルのチャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN=

# メッセージ送信先のLINEユーザーID (またはグループID/ルームID)
LINE_USER_ID=

# 省略可。設定すると、Claude APIでタスクを秘書らしい文章に整えて送信します。
# 未設定の場合は定型フォーマットのメッセージを送信します。
ANTHROPIC_API_KEY=

# 省略可。ANTHROPIC_API_KEY使用時のモデル指定。デフォルトは claude-sonnet-5。
ANTHROPIC_MODEL=

# ローカルで動作確認する際に、LINEへの実送信をスキップしてコンソール出力だけ確認したい場合に設定。
DRY_RUN=

# --- X記事(キジ)の参考記事データベース連携 ---
# https://www.firecrawl.dev/ でサインアップして発行するAPIキー。参考記事URLの本文取得に使用。
# Claude Code Cloud環境(Pro/Maxプラン)を使っている場合は、ここではなく環境設定の
# 「API credentials」でapi.firecrawl.devへのBearerトークンとして登録する方が安全です
# (キーがセッションのVM・環境変数に一切入らないため)。その場合はこの行を空のままでOK。
FIRECRAWL_API_KEY=

# Googleスプレッドシートへの記事データベース自動追記に使用するサービスアカウントの認証情報。
# 1. Google Cloud Consoleでプロジェクトを作成し、「Google Sheets API」を有効化
# 2. 「APIとサービス」→「認証情報」でサービスアカウントを作成し、JSON形式の鍵を発行
# 3. 記事データベース用のGoogleスプレッドシートを作成し、共有設定でサービスアカウントの
#    メールアドレス(JSON鍵の client_email)を「編集者」として追加
# 4. 下記3つをJSON鍵とスプレッドシートのURLから設定(GOOGLE_SHEET_IDはスプレッドシートURLの
#    https://docs.google.com/spreadsheets/d/<この部分>/edit )
#    GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEYはJSON鍵のprivate_keyの値をそのまま1行で貼り付ける
#    (改行は \n のまま。実際の改行文字にしない)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
