{
  "name": "line-ai-secretary",
  "version": "1.0.0",
  "private": true,
  "description": "Sends today's tasks to LINE every morning, written up by an AI secretary.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "send": "node src/sendDailyTasks.js",
    "send:dry-run": "DRY_RUN=1 node src/sendDailyTasks.js",
    "get-user-id": "node src/getUserId.js",
    "generate:posts": "node src/generatePostDrafts.js",
    "scrape-article": "node src/scrapeArticle.js",
    "setup-article-sheet": "node src/setupArticleSheet.js",
    "add-article": "node src/appendArticleRow.js"
  },
  "dependencies": {
    "googleapis": "^181.0.0",
    "js-yaml": "^4.1.0"
  }
}
